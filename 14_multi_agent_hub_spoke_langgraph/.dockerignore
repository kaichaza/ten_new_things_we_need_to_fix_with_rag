# Build context exclusions. The Dockerfile does "COPY . ." so anything not
# excluded here is baked into the image.

# Virtual environments. The image builds its own with uv sync.
.venv/
venv/

# Python bytecode and tool caches.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Secrets. Supplied at run time with --env-file, never an image layer.
# .env.example is not excluded: it documents what the container needs.
.env
.env.local
.env.production

# Version control and editor state.
.git/
.gitignore
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs and local scratch.
*.log
*.bak
*.bak.*

# The orders log the gate writes. Regenerated by the walkthrough.
data/
