OPENAI_API_KEY=sk-your-key-here

# Everything in this exercise runs on the cheap tier: the router, the
# spokes and the judge. Escalation to a strong tier is exercise 07's topic.
MODEL_CHEAP=gpt-4.1-mini

# USD per million tokens for MODEL_CHEAP. These are the numbers the cost
# ceiling is enforced against, so verify them against the current OpenAI
# price list before quoting the walkthrough's figures.
PRICE_IN_CHEAP=0.40
PRICE_OUT_CHEAP=1.60

# --- Observability -----------------------------------------------------------
# Langfuse SDK v4. Leave the placeholders in place to run without Langfuse;
# a missing or placeholder key degrades tracing, never the turn.
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
LANGFUSE_HOST=https://cloud.langfuse.com
# Process-level environment attribute on the Langfuse client (v4 puts it on
# the constructor rather than on per-invocation metadata).
APP_ENV=practice
