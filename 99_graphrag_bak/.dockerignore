# Build context exclusions. Each Dockerfile does "COPY . ." so anything not
# excluded here is baked into the image.

# Virtual environments. The image builds its own with uv sync; copying the
# host's would be several hundred megabytes of the wrong platform's wheels.
.venv/
venv/

# Python bytecode and tool caches.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Secrets. The key is supplied at run time with --env-file, so it never
# becomes an image layer that "docker history" would reveal.
# .env.example is not excluded: it documents what the container needs.
.env
.env.local
.env.production

# Version control and editor state.
.git/
.gitignore
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs and local scratch.
*.log
*.bak
*.bak.*

# Everything the graphrag pipeline generates. input/ is a copy of corpus/,
# output/ is the parquet artifacts, settings.yaml is scaffolded by
# "graphrag init" at run time.
#
# Note: excluding output/ means a container run re-indexes from scratch,
# which makes real model calls. That is the correct behaviour for a clean
# image - comment out the output/ line if you would rather ship the
# pre-built index and avoid the cost.
input/
output/
cache/
logs/
settings.yaml
.env.graphrag
