# Copy this file to .env and add your key.
#
#     cp .env.example .env
#
# Same OpenAI key as every other exercise in this repository.

OPENAI_API_KEY=sk-your-key-here

# GraphRAG's own config references ${GRAPHRAG_API_KEY}, which is just a
# variable name rather than a separate service or credential. main.py copies
# OPENAI_API_KEY into it at import, so setting the line above is enough.
# Set this instead only if you want a different key for graphrag specifically.
# GRAPHRAG_API_KEY=sk-your-key-here
